# ── ResumeNavigator environment ───────────────────────────────────────────
# Copy to backend/.env and fill in real keys where needed.

# Gemini LLM (algorithm #5) — resume validation, roles, roadmap JSON
GEMINI_API_KEY=your_gemini_api_key

# Live India job providers (optional; free boards still work without keys)
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=jsearch.p.rapidapi.com
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# ── Algorithm stack ───────────────────────────────────────────────────────
# 1) NLP parsing is always on (PDF/DOCX + rules/regex).
# 2–3) TF-IDF + Logistic Regression auto-train/load on first analyze
#     (requires scikit-learn; already in requirements.txt).
# 4) Sentence Transformers + Cosine Similarity:
#     pip install -r requirements-ml.txt
ENABLE_EMBEDDINGS=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SKILL_SIM_THRESHOLD=0.55
